# ——— Website (Vite) ———
# Local dev: copy this file to `.env`
# Production builds: `.env.production` (committed) or the host's environment.
#
# Public Google Apps Script Web App URL. This is not a secret.
# Leave the placeholder until you deploy google-apps-script/Code.gs and paste the
# /exec URL from Deploy → Web app. Setup: google-apps-script/README.md
VITE_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Optional. Read only by `npm run build:preview`. Point it at a test Web App,
# never the production lead sheet. Leave unset to disable preview submissions.
# VITE_PREVIEW_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_TEST_DEPLOYMENT_ID/exec

# ——— Google Apps Script → Project Settings → Script Properties ———
# The React app does not read these. Do not prefix them with VITE_.
# Vite would publish any VITE_ value in the public JavaScript bundle.
# Paste them in Apps Script, then run testLeadEmail(). See google-apps-script/README.md.
#
# Get an API key: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key

# Must be a verified sender in Resend (use onboarding@resend.dev only for a Resend test)
RESEND_FROM_EMAIL=EMORI Franchise <contact@ifranchise.in>

# Inbox that receives new franchise leads. Comma-separated addresses are allowed.
LEAD_NOTIFICATION_EMAIL=contact@ifranchise.in

# Optional. Public site origin, no trailing slash. The script loads
# {SITE_URL}/brand/emori-logo.webp for the notification email and falls back to
# a text wordmark when the file is missing. Not read by Vite.
SITE_URL=https://your-live-site.com
