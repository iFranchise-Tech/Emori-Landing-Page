{
  "name": "emori",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:preview": "tsc -b && VITE_GOOGLE_SCRIPT_URL=${VITE_PREVIEW_GOOGLE_SCRIPT_URL:-} vite build --mode preview",
    "lint": "oxlint",
    "preview": "vite preview",
    "preview:cloudflare": "npm run build:preview && npx --yes wrangler@4 dev",
    "deploy:cloudflare:preview": "npm run build:preview && npx --yes wrangler@4 deploy --name emori-landing-page-preview",
    "images:webp": "node scripts/convert-to-webp.mjs"
  },
  "dependencies": {
    "framer-motion": "^13.0.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "oxlint": "^1.75.0",
    "sharp": "^0.35.3",
    "typescript": "~6.0.2",
    "vite": "^5.4.11"
  }
}
